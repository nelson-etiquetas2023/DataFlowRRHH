@page "{id:int}"
@model DataFlowRRHH.Pages.Feriados.UpdateModel

<p class="lead">
    <i class="bi bi-pencil-fill me-2"></i>EDITAR DIAS FERIADOS:
</p>
<div class="row">
    <div class="col-6">
        <form method="post" class="mt-3">
            <div class="form-group mb-2">
                <strong><label class="form-label">Id. Feriado: </label></strong>
                <input type="text" class="form-control"
                placeholder="Id. Feriado"
                asp-for="EditFeriado.IdException"
                readonly />
            </div>
            <div class="form-group mb-2">
                <strong><label for="name-feriado">Nombre dia feriado: </label></strong>
                <input type="text" class="form-control" id="name-feriado"
                       aria-describedby="nameferiado"
                       placeholder="Nombre dia feriado"
                       asp-for="EditFeriado.Description"
                       />
            </div>
            <div class="form-group mb-2">
                <strong><label for="start-date">Fecha Inicio: </label></strong>
                <input type="date" class="form-control"
                       id="start-date"
                       asp-for="EditFeriado.BeginingDate"
                       />
            </div>
            <div class="form-group mb-2">
                <strong><label for="end-date">Fecha Final: </label></strong>
                <input type="date"
                       class="form-control"
                       id="end-date"
                       asp-for="EditFeriado.EndingDate"
                       />
            </div>
            <div class="form-group mb-5">
                <strong><label for="factor-pago">Factor de Pago [%]: </label></strong>
                <input type="text"
                       class="form-control"
                       id="factor-pago"
                       asp-for="EditFeriado.PaymentFactor"
                       />
            </div>
            <div class="input-group mb-5">
                <div class="form-floating" style="width:600px;">
                    <textarea class="form-control"
                              placeholder="Coementario general acerca del dia feriado:"
                              id="floatingTextarea2"
                              style="height: 100px"
                              asp-for="EditFeriado.Comment"></textarea>
                    <label for="floatingTextarea2">Comentario General:</label>
                </div>
            </div>
            <div class="form-check mb-5">
                <input type="checkbox"
                       class="form-check-input"
                       id="exampleCheck1"
                       asp-for="EditFeriado.Recurring"
                       >
                <label class="form-check-label" for="exampleCheck1"><strong>Recurrente</strong> </label>
            </div>

            <div class="row" style="display: flex;justify-content:center;align-items:center;">
                <div class="col-6"  >
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-calendar2-event me-2"></i>Guardar
                    </button>
                    <a class="btn btn-primary" href="/feriados/index"><i class="bi bi-arrow-left-square me-2"></i>Pagina principal</a>
                </div>   
            </div>

            

        </form>
    </div>
    <div class="col-6 d-flex justify-content-center align-items-md-center">
        <img src="~/images/calendario-de-incidencias.png" width="350" height="350" />
    </div>
</div>

