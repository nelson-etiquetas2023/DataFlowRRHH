@page 
@model DataFlowRRHH.Pages.Feriados.IndexModel

<h5 class="modal-title me-4 mb-3" id="exampleModalLabel">Dias Feriados y Excepciones.</h5>
<!-- Button Ejecutar crear feriado-->
<a class="btn btn-primary mb-3" href="/feriados/create">Crear Feriado</a>

@if (Model.Feriados != null && Model.Feriados.Any())
{
    <table id="TableFeriado" class="table table-striped nowrap">
        <thead>
            <tr>
                <th>
                    Id.
                </th>
                <th>
                    Fecha Inicio.
                </th>
                <th>
                    Fecha Final.
                </th>
                <th>
                    Descripcion
                </th>
                <th>
                    Factor
                </th>
                <th>
                    Recurrente.
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feriado in Model.Feriados)
            {
                <tr>
                    <td>
                        @feriado.IdException
                    </td>
                    <td>
                        @feriado.BeginingDate
                    </td>
                    <td>
                        @feriado.EndingDate
                    </td>
                    <td>
                        @feriado.Description
                    </td>
                    <td>
                        @feriado.PaymentFactor
                    </td>
                    <td>
                        @feriado.Recurring
                    </td>
                    <td>
                        <a href="/feriados/update/@feriado.IdException" class="btn btn-primary">Editar</a>
                        <button class="btn btn-danger">Borrar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay registros</p>
}



<!--------------------------------->




@section Scripts
{
    <script>
        let tablefer = new DataTable('#TableFeriado', {
            language:
            {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
            },
            select: true
        });

    </script>
}





