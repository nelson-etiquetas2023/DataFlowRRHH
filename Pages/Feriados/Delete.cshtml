@page "{id:int}"
@model DataFlowRRHH.Pages.Feriados.DeleteModel

<p class="lead">
    <i class="bi bi-folder-x me-2"></i>ELIMINAR DIAS FERIADOS:
</p>

<div class="row">
    <div class="col-6">
        <form method="post" class="mt-3" id="form-delete">
            <div class="form-group mb-2">
                <strong><label class="form-label">Id. Feriado: </label></strong>
                <input type="text" class="form-control"
                       placeholder="Id. Feriado"
                       asp-for="DeleteFeriado.IdException"
                       readonly />
            </div>
            <div class="form-group mb-2">
                <strong><label for="name-feriado">Nombre dia feriado: </label></strong>
                <input type="text" class="form-control" id="name-feriado"
                       aria-describedby="nameferiado"
                       placeholder="Nombre dia feriado"
                       asp-for="DeleteFeriado.Description"
                       readonly
                       />
            </div>
            <div class="form-group mb-2">
                <strong><label for="start-date">Fecha Inicio: </label></strong>
                <input type="date" class="form-control"
                       id="start-date"
                       asp-for="DeleteFeriado.BeginingDate"
                       readonly
                       />
            </div>
            <div class="form-group mb-2">
                <strong><label for="end-date">Fecha Final: </label></strong>
                <input type="date"
                       class="form-control"
                       id="end-date"
                       asp-for="DeleteFeriado.EndingDate"
                       readonly
                       />
            </div>
            <div class="form-group mb-5">
                <strong><label for="factor-pago">Factor de Pago [%]: </label></strong>
                <input type="text"
                       class="form-control"
                       id="factor-pago"
                       asp-for="DeleteFeriado.PaymentFactor"
                       readonly
                       />
            </div>
            <div class="input-group mb-5">
                <div class="form-floating" style="width:600px;">
                    <textarea class="form-control"
                              placeholder="Comentario general acerca del dia feriado:"
                              id="floatingTextarea2"
                              style="height: 100px"
                              asp-for="DeleteFeriado.Comment"
                              readonly
                              ></textarea>
                    <label for="floatingTextarea2">Comentario General:</label>
                </div>
            </div>
            <div class="form-check mb-5">
                <input type="checkbox"
                       class="form-check-input"
                       id="exampleCheck1"
                       asp-for="DeleteFeriado.Recurring"
                       readonly
                       >
                <label class="form-check-label" for="exampleCheck1"><strong>Recurrente</strong> </label>
            </div>

            <div class="row">
                <div class="col-8">
                    <button class="btn btn-danger" id="btn-eliminar"><i class="bi bi-trash3 me-2"></i>Eliminar Feriado</button>
                    <a class="btn btn-primary" href="/feriados/index"><i class="bi bi-arrow-left-square me-2"></i>Pagina principal</a>
                </div>
            </div>
        </form>
    </div>
    <div class="col-6 d-flex justify-content-center align-items-md-center">
        <img src="~/images/calendario-de-incidencias.png" width="350" height="350" />
    </div>
</div>

@section Scripts 
{
    <script>

        $('#btn-eliminar').click(function (e) {
            e.preventDefault();
            var url = $(e).attr("href");
            Swal.fire({
                title: "Ustes esta seguro de Eliminar este Elemento?",
                text: "No se podra revertir esta operacion!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Si, estoy seguro Eliminalo!",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminado!",
                        text: "Registro eliminado de la Base de Datos.",
                        icon: "success"
                    });
                    window.location.href = url;
                    $("#form-delete").submit();
                }
            });
        });
    </script>
}




