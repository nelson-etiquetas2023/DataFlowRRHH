@page
@model DataFlowRRHH.Pages.Usuario.CreateModel
<h5>Create Usuario</h5>

<div class="row">
    <div class="col-6">
        <form method="post">
            <div class="form-group mb-3">
                <label for="name">Nombre de Usuario:</label>
                <input type="text" class="form-control shadow" placeholder="Introduzca el nombre del usuario" id="name" 
                asp-for="@Model.Usuario.Name"
                />
            </div>
            <div class="form-group mb-3">
                <label for="email">Correo Electronico:</label>
                <input type="text" class="form-control shadow" placeholder="Introduzca el correo electronico" id="email" 
                asp-for="@Model.Usuario.Email"
                />
            </div>
            <div class="form-group mb-3">
                <label for="password">Contraseña:</label>
                <input type="password" class="form-control shadow" placeholder="Introduzca la contraseña del usuario" id="password" 
                asp-for="@Model.Usuario.Password"
                />
            </div>
            <div class="form-group mb-3">
                <label>Tipo de Usuario:</label>
                <select asp-for="@Model.Usuario.TypeUser" asp-items="@(new SelectList(Model.TipoUsuarios, "Name", "Name"))"
                        class="form-select shadow">
                    <option selected disabled>Seleccione un tipo de usuario</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label>Departamento:</label>
                <select asp-for="@Model.Usuario.Departament" asp-items="@(new SelectList(Model.OptionsDepart, "Name", "Name"))"
                        class="form-select shadow">
                    <option selected disabled>Seleccione un Departamento</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label for="phone">Telefono:</label>
                <input type="text" class="form-control shadow" placeholder="Introduzca el telefono del usuario" id="phone"
                asp-for="@Model.Usuario.Phone" />
            </div>

            <div class="row" style="display:flex; align-content:center; align-items:center;">
                <div class="col-6">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a href="#" class="btn btn-primary">Volver al Main</a>
                </div>
            </div>
        </form>
    </div>
</div>